# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_DB_NAME=medicare

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - your frontend origin(s), comma separated
# 5173 is the Vite dev server's default port used by medicare-frontend
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# OCR (tesseract binary path, only needed on Windows)
TESSERACT_CMD=

# LLM provider for AI Assistant. Leave blank to run in offline/rule-based fallback mode.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
